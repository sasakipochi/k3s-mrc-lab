{
 "title": "MRC ラボ",
 "uid": "mrc-lab",
 "timezone": "browser",
 "refresh": "5s",
 "schemaVersion": 39,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "方式",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "max(mrc_mode{mode=\"mrc\"}) * 1 + max(mrc_mode{mode=\"conv\"}) * 2",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "停止中"
        },
        "1": {
         "text": "MRC"
        },
        "2": {
         "text": "従来方式"
        }
       }
      }
     ],
     "color": {
      "mode": "fixed",
      "fixedColor": "#3987e5"
     },
     "noValue": "–"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "実効スループット",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rate(mrc_delivered_bytes_total[10s]) * 8",
     "instant": true
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "mappings": [],
